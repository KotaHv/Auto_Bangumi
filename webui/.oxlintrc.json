{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/error-boundaries": "off",
    "react/forward-ref-uses-ref": "off",
    "react/globals": "off",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react/jsx-key": "off",
    "react/jsx-no-duplicate-props": "off",
    "react/jsx-no-undef": "off",
    "react/jsx-props-no-spread-multi": "off",
    "react/no-children-prop": "off",
    "react/no-danger-with-children": "off",
    "react/no-did-mount-set-state": "off",
    "react/no-did-update-set-state": "off",
    "react/no-direct-mutation-state": "off",
    "react/no-find-dom-node": "off",
    "react/no-is-mounted": "off",
    "react/no-render-return-value": "off",
    "react/no-string-refs": "off",
    "react/no-this-in-sfc": "off",
    "react/no-unsafe": "off",
    "react/no-will-update-set-state": "off",
    "react/preserve-manual-memoization": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/set-state-in-render": "off",
    "react/static-components": "off",
    "react/use-memo": "off",
    "react/void-dom-elements-no-children": "off",
    "react/void-use-memo": "off",
    "no-unused-vars": "error",
    "typescript/consistent-type-imports": "warn",
    "import/no-cycle": ["error", { "ignoreTypes": false }],
    "import/default": "off",
    "import/namespace": "off"
  },
  "overrides": [
    {
      "files": ["src/features/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["@/app/**", "@/features/**"]
          }
        ]
      }
    },
    {
      "files": ["src/features/rss/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@/app/**",
              {
                "group": [
                  "@/features/**",
                  "!@/features/bangumi",
                  "!@/features/bangumi/**"
                ],
                "message": "RSS may depend only on the approved Bangumi feature edge."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/search/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@/app/**",
              {
                "group": [
                  "@/features/**",
                  "!@/features/bangumi",
                  "!@/features/bangumi/**",
                  "!@/features/rss",
                  "!@/features/rss/**"
                ],
                "message": "Search may depend only on the approved Bangumi and RSS feature edges."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/shared/**/*.{ts,tsx}",
        "src/components/ui/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["@/features/**"]
          }
        ]
      }
    },
    {
      "files": ["src/lib/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["@/features/**"]
          }
        ]
      }
    }
  ]
}
